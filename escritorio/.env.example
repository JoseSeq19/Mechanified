# ---------------------------------------------------------------
# Mechanified · empaquetado del ejecutable para Windows
# Copiar a .env y completar. Lo lee `npm run empaquetar`, y lo que
# diga queda fijo dentro de Mechanified.exe.
#
# Nada de esto es secreto: el ejecutable se reparte a los clientes.
# Ni la llave de servicio ni la cadena de Postgres van aquí nunca.
# ---------------------------------------------------------------

# La API central de Mechanified. El ejecutable le reenvía todo lo que
# la aplicación pide a /api. Para probar en local: http://127.0.0.1:8000
MCH_API_URL=

# El sitio público (página de presentación, registro, descarga).
# Los enlaces de "crear cuenta" de la aplicación y la vuelta del
# correo de recuperación de contraseña llevan aquí.
MCH_URL_SITIO=
