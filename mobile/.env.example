# Configuración de la app de campo.
#
# No se lee en marcha: se pasa al compilar. Flutter sabe leer este mismo
# archivo y convertir cada línea en una constante del programa:
#
#     flutter run   --dart-define-from-file=.env
#     flutter build apk --dart-define-from-file=.env
#
# Copia este archivo a `.env` y rellena la llave anónima con la que imprime
# `supabase status`.
#
# Las direcciones son las del emulador de Android: dentro del emulador,
# `localhost` es el propio emulador, y la máquina de desarrollo es 10.0.2.2.
# En el simulador de iOS o en escritorio, usa localhost. En un móvil de verdad,
# la IP de tu máquina en la red local.
MCH_API_URL=http://10.0.2.2:8000
MCH_SUPABASE_URL=http://10.0.2.2:54321
MCH_SUPABASE_ANON_KEY=
