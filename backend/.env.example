# ---------------------------------------------------------------
# Mechanified · backend · variables de entorno
# Copiar a .env y completar. NUNCA versionar el .env real.
# Los valores locales los imprime `supabase start`.
# ---------------------------------------------------------------

MCH_ENTORNO=desarrollo
MCH_LOG_NIVEL=INFO

# Conexión directa a Postgres (SQLAlchemy + asyncpg).
# Local por defecto de Supabase CLI:
MCH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# API de Supabase
MCH_SUPABASE_URL=http://127.0.0.1:54321
MCH_SUPABASE_ANON_KEY=
# Solo para el worker de notificaciones y tareas de sistema.
# Esta llave omite RLS: jamás usarla en el camino de un request de usuario.
MCH_SUPABASE_SERVICE_ROLE_KEY=

# Solo para proyectos que aun firman con el esquema heredado HS256. Con llaves
# asimetricas (ES256/RS256, lo actual) se deja vacio: el backend verifica contra
# el JWKS del proyecto, sin secreto compartido.
MCH_SUPABASE_JWT_SECRET=
MCH_JWT_AUDIENCIA=authenticated

# Orígenes permitidos por CORS, separados por coma
MCH_CORS_ORIGENES=http://localhost:5173,http://localhost:3000

# URL pública de la web, para armar los enlaces de aprobación de
# presupuesto y de encuesta que se envían al cliente
MCH_URL_PUBLICA_WEB=http://localhost:5173

# --- Correo saliente ---
# buzon = no se envía nada: cada mensaje se guarda como .eml en backend/buzon/
# para poder abrirlo y verlo tal cual lo recibiría el cliente. Es el modo de
# desarrollo. smtp = envío real; exige MCH_SMTP_HOST.
MCH_EMAIL_MODO=buzon
MCH_EMAIL_REMITENTE=notificaciones@mechanified.local
MCH_EMAIL_BUZON=buzon

MCH_SMTP_HOST=
MCH_SMTP_PUERTO=587
MCH_SMTP_USUARIO=
MCH_SMTP_CLAVE=
# starttls (587), ssl (465) o ninguna
MCH_SMTP_SEGURIDAD=starttls

# --- Worker de notificaciones ---
# Embebido en la API para desarrollo. En producción: false, y se corre aparte
# con `python -m app.worker`.
MCH_WORKER_EMBEBIDO=true
MCH_WORKER_INTERVALO_SEG=10
MCH_WORKER_LOTE=20
