# URL del backend FastAPI
# Ruta relativa: la sirve el proxy de Vite hacia la API (ver vite.config.ts).
# Asi el navegador nunca hace una peticion entre origenes en desarrollo.
# Mechanified.exe hace lo mismo con su propio reenvio, y al empaquetar se fija
# siempre a /api. Si el sitio se publica donde no se puede reenviar /api, va
# una URL absoluta en web/.env.sitio, que solo lee `vite build --mode sitio`.
VITE_API_URL=/api

# Supabase (solo para el flujo de autenticación del navegador)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Dirección pública del sitio. La usa la aplicación para los enlaces de
# "crear cuenta" y como vuelta del correo de recuperación de contraseña.
# Al empaquetar el ejecutable la pone escritorio/.env (MCH_URL_SITIO).
VITE_URL_SITIO=http://localhost:5174
