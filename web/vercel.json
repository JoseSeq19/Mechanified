{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:sitio",
  "outputDirectory": "dist-sitio",
  "rewrites": [
    { "source": "/api/:ruta*", "destination": "https://mechanified-api.vercel.app/:ruta*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/:ruta*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}
